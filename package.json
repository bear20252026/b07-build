{
  "name": "ai-work-os",
  "version": "0.19.0",
  "private": true,
  "description": "AI Work OS 积木式 monorepo（pnpm 不可用 → npm workspaces）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.base.json",
    "architecture:dependencies": "depcruise apps packages --exclude \"(src-tauri[\\\\/](resources|target)|apps[\\\\/]workbench[\\\\/]dist)\" --config .dependency-cruiser.cjs --output-type err",
    "architecture:policy": "node --import tsx tools/architecture/policy.ts",
    "architecture:policy:report": "node --import tsx tools/architecture/policy.ts report",
    "architecture:baseline:update": "node --import tsx tools/architecture/policy.ts baseline:update",
    "architecture:graph": "node --import tsx tools/architecture/graph.ts",
    "architecture:graph:check": "node --import tsx tools/architecture/graph.ts --check",
    "architecture:check": "npm run architecture:dependencies && node tools/architecture-check.mjs && npm run architecture:policy && npm run architecture:graph:check",
    "version:check": "node tools/verify-desktop-release-version.mjs",
    "test": "npm run architecture:check && node tools/run-tests.mjs",
    "test:unit": "node tools/run-tests.mjs",
    "benchmark:dag": "node --import tsx packages/agent-runtime/benchmark/dag-scheduler.bench.ts",
    "build": "npm run typecheck",
    "desktop:dev": "npm run dev --workspace=@awo/desktop-shell",
    "desktop:build": "npm run build --workspace=@awo/desktop-shell",
    "desktop:typecheck": "npm run typecheck --workspace=@awo/desktop-shell",
    "android:init": "npm exec --workspace=@awo/desktop-shell -- tauri android init --ci",
    "android:build:apk": "npm exec --workspace=@awo/desktop-shell -- tauri android build --apk --target aarch64",
    "android:build:aab": "npm exec --workspace=@awo/desktop-shell -- tauri android build --aab",
    "performance:check": "npm run build --workspace=@awo/workbench && node tools/performance-budget.mjs",
    "agency:catalog": "node --import tsx tools/generate-agency-role-catalog.mjs && node --import tsx tools/emit-workbench-agency-catalog.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "0.25.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "fast-uri": "^3.1.8"
  }
}
