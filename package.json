{
  "name": "ai-work-os",
  "version": "0.13.0",
  "private": true,
  "description": "AI Work OS 积木式 monorepo（pnpm 不可用 → npm workspaces）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.base.json",
    "test": "node --experimental-sqlite --import tsx --test $(find packages apps -path '*test/*.test.ts' -print)",
    "benchmark:dag": "node --import tsx packages/agent-runtime/benchmark/dag-scheduler.bench.ts",
    "build": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  }
}
