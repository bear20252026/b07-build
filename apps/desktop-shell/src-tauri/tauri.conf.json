{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Work OS",
  "version": "0.1.0",
  "identifier": "com.bear20252026.aiworkos",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@awo/workbench -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --workspace=@awo/workbench",
    "frontendDist": "../../workbench/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Work OS",
        "width": 1440,
        "height": 960,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "maximized": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI Work OS local-first desktop workbench",
    "longDescription": "A desktop workbench with direct user-configured Provider connections and local project workspaces.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
