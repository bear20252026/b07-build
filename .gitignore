# 依赖与构建产物（一律不入库）
node_modules/
target/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 本地环境/密钥
.env
.env.*
*.local
*.pem
!*.example

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 本地 Agent 运行时快照（可从任务重新生成，绝不提交）
.awo/

# 本地 Windows 发布候选包（由受控脚本生成，工件不提交）
artifacts/
.cloud-artifacts-*/

# 桌面 Gateway sidecar 由受控 Windows 构建脚本生成，二进制和中间 bundle 不入库
apps/desktop-shell/src-tauri/binaries/awo-runtime-gateway-*
apps/desktop-shell/src-tauri/binaries/awo-runtime-gateway-bundle.cjs
apps/desktop-shell/src-tauri/binaries/awo-runtime-gateway-sea.json
# 固定脚本可再生成的 SearXNG Windows Python 运行时和依赖，不提交大型二进制资源
apps/desktop-shell/src-tauri/resources/research/python-runtime/*
!apps/desktop-shell/src-tauri/resources/research/python-runtime/.gitkeep
# Tauri CLI 与 Android 初始化可从配置重新生成，绝不提交本机 Gradle/schemas 产物
apps/desktop-shell/src-tauri/gen/
